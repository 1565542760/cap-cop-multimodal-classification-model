{
  "analysis_name": "clinical_input_availability_sensitivity",
  "status": "post_hoc_exploratory_ablation",
  "description": "Fixed lesion-ROI radiomics probabilities with controlled clinical-input perturbations.",
  "clinical_features": [
    "age",
    "height_cm",
    "weight_kg",
    "body_mass_index",
    "fever",
    "cough",
    "sputum_category",
    "chest_tightness",
    "dyspnoea",
    "haemoptysis",
    "weight_loss",
    "lymphocyte_count",
    "erythrocyte_sedimentation_rate",
    "c_reactive_protein",
    "high_sensitivity_c_reactive_protein",
    "procalcitonin"
  ],
  "core_features": [
    "age",
    "body_mass_index",
    "fever",
    "cough",
    "sputum_category",
    "weight_loss",
    "lymphocyte_count"
  ],
  "seeds": [20260908, 20260909, 20260910],
  "outer_folds": 5,
  "clinical_model": {
    "family": "random_forest",
    "augmentation": "balanced_bootstrap",
    "n_estimators": 300,
    "max_features": "sqrt",
    "min_samples_leaf": 5,
    "n_jobs": 1,
    "positive_class": "COP",
    "negative_class": "CAP"
  },
  "fusion": {
    "internal_weight_source": "locked Model A per-fold weights in the canonical replay table",
    "external_clinical_weight": 0.7,
    "external_imaging_weight": 0.3,
    "threshold": 0.5,
    "image_probability_source": "outputs/final_public_multimodal_replay_20261012/primary_lesion_radiomics_*_canonical_replay.csv"
  },
  "scenarios": [
    {"name": "full_clinical_input", "type": "clean", "features": "full_clinical_input"},
    {"name": "random_missing_20pct", "type": "random_missing", "rate": 0.2, "features": "full_clinical_input"},
    {"name": "random_missing_30pct", "type": "random_missing", "rate": 0.3, "features": "full_clinical_input"},
    {"name": "inflammatory_laboratory_panel_unavailable", "type": "fixed_missing", "features": "full_clinical_input", "missing_features": ["lymphocyte_count", "erythrocyte_sedimentation_rate", "c_reactive_protein", "high_sensitivity_c_reactive_protein", "procalcitonin"]},
    {"name": "core_clinical_input", "type": "feature_subset", "features": "core_clinical_input"},
    {"name": "missing_age", "type": "fixed_missing", "features": "full_clinical_input", "missing_features": ["age"]},
    {"name": "missing_height_cm", "type": "fixed_missing", "features": "full_clinical_input", "missing_features": ["height_cm"]},
    {"name": "missing_weight_kg", "type": "fixed_missing", "features": "full_clinical_input", "missing_features": ["weight_kg"]},
    {"name": "missing_body_mass_index", "type": "fixed_missing", "features": "full_clinical_input", "missing_features": ["body_mass_index"]},
    {"name": "missing_fever", "type": "fixed_missing", "features": "full_clinical_input", "missing_features": ["fever"]},
    {"name": "missing_cough", "type": "fixed_missing", "features": "full_clinical_input", "missing_features": ["cough"]},
    {"name": "missing_sputum_category", "type": "fixed_missing", "features": "full_clinical_input", "missing_features": ["sputum_category"]},
    {"name": "missing_chest_tightness", "type": "fixed_missing", "features": "full_clinical_input", "missing_features": ["chest_tightness"]},
    {"name": "missing_dyspnoea", "type": "fixed_missing", "features": "full_clinical_input", "missing_features": ["dyspnoea"]},
    {"name": "missing_haemoptysis", "type": "fixed_missing", "features": "full_clinical_input", "missing_features": ["haemoptysis"]},
    {"name": "missing_weight_loss", "type": "fixed_missing", "features": "full_clinical_input", "missing_features": ["weight_loss"]},
    {"name": "missing_lymphocyte_count", "type": "fixed_missing", "features": "full_clinical_input", "missing_features": ["lymphocyte_count"]},
    {"name": "missing_erythrocyte_sedimentation_rate", "type": "fixed_missing", "features": "full_clinical_input", "missing_features": ["erythrocyte_sedimentation_rate"]},
    {"name": "missing_c_reactive_protein", "type": "fixed_missing", "features": "full_clinical_input", "missing_features": ["c_reactive_protein"]},
    {"name": "missing_high_sensitivity_c_reactive_protein", "type": "fixed_missing", "features": "full_clinical_input", "missing_features": ["high_sensitivity_c_reactive_protein"]},
    {"name": "missing_procalcitonin", "type": "fixed_missing", "features": "full_clinical_input", "missing_features": ["procalcitonin"]}
  ]
}
